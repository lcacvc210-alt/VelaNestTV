# Required: choose your own strong password, never commit .env.local
PASSWORD=replace-with-your-own-password
# Optional: API source JSON arrays. No third-party sources are bundled.
DEFAULT_SOURCES=[]
DEFAULT_LIVE_SOURCES=[]
# Enable only if you use trusted private-network live playlist URLs
LIVE_ALLOW_PRIVATE=0
REQUEST_TIMEOUT=8000
MAX_RETRIES=1
DEBUG=false
