# Must match backend/.env.local
PASSWORD=replace-with-your-own-password
CORE_URL=http://127.0.0.1:8080
# Optional absolute media folder. Default: repository/media
# NAS_ROOT=F:/Movies

# Optional: disable companion external metadata/suggestion requests
# EXTERNAL_METADATA=false
# BIND_HOST=0.0.0.0
# Default TV ports are 8090/45831; override only for isolated tests.
# COMPANION_PORT=8090
# DISCOVERY_PORT=45831
# COMPANION_DATA_DIR=./data
